# Redis 连接
REDIS_URL=redis://127.0.0.1:6379/0

# 服务端口
PORT=8000

# 多店铺配置（生产环境用 JSON 文件或环境变量注入，下面是示例）
# 配置数组，每行一个店铺；关键字段：
# shop_user_name: 小店 ToUserName（gh_xxx）
# app_id / app_secret: 小店应用凭据
# token / encoding_aes_key: 自研消息推送配置
# weiyu_base_url: 微语（bytedesk）地址，例如 http://127.0.0.1:9003
# weiyu_tenant_token: 该店铺对应微语租户的鉴权 token
# weiyu_agent_uid: 客服实体 UID，用于路由会话
# weiyu_agent_user_uid: 可选，客服对应登录用户 UID，用于校验实时订阅；不填时通过微语接口解析
# default_welcome: 默认欢迎语
# keywords_to_human: 命中即转人工的关键词列表（逗号分隔）
SHOPS_JSON='[
  {
    "shop_user_name": "gh_example1",
    "app_id": "replace_with_your_app_id",
    "app_secret": "your_app_secret_1",
    "token": "your_token_1",
    "encoding_aes_key": "43_char_encoding_aes_key_1_base64_strict_43",
    "weiyu_base_url": "http://127.0.0.1:9003",
    "weiyu_tenant_token": "bytedesk_tenant_token_1",
    "weiyu_agent_uid": "df_ag_uid",
    "weiyu_agent_user_uid": "",
    "default_welcome": "您好，很高兴为您服务 ~",
    "keywords_to_human": ["人工", "客服", "人工客服", "转人工"]
  }
]'

# 通用
LOG_LEVEL=INFO
# 回调处理超时硬上限（微信小店要求 5 秒内回 success）
WEBHOOK_TIMEOUT_SECONDS=4.5
# 是否开启调试模式（打印更多日志）
DEBUG=false

# 微语数据库（仅示例；生产请使用独立账号和权限受限的私有连接）
WEIYU_MYSQL_HOST=127.0.0.1
WEIYU_MYSQL_PORT=13306
WEIYU_MYSQL_USER=bridge_user
WEIYU_MYSQL_PASSWORD=replace_with_private_database_password
WEIYU_MYSQL_DATABASE=bytedesk

# 私有任务数据库：包含消息与媒体地址，禁止提交或打包发布
DELIVERY_DB_PATH=.runtime/delivery.sqlite3
